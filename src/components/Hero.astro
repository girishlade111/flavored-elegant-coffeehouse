---
import Icon from './Icon.astro';
import CupArt from './CupArt.astro';
import { siteData } from '../data/site';

const { hero } = siteData;
---

<section class="hero-section" id="home" aria-labelledby="hero-heading">
  <div class="hero-grid">
    {/* Left Column: Heading, Primary CTA, Feature Chips */}
    <div class="hero-content" data-reveal>
      <h1 class="hero-heading" id="hero-heading">
        <span class="heading-line">{hero.headingLine1}</span>
        <span class="heading-line">{hero.headingLine2}</span>
      </h1>

      <div class="hero-cta-wrapper">
        <a href={hero.ctaHref} class="btn-pill btn-espresso hero-cta-btn">
          {hero.ctaText}
        </a>
      </div>

      {/* Row of 4 Icon Chips */}
      <div class="chips-row" role="group" aria-label="Coffee categories">
        {hero.chips.map((chip) => (
          <a
            href={chip.href}
            class="chip-button"
            aria-label={chip.label}
          >
            <Icon name={chip.icon as any} size={28} />
          </a>
        ))}
      </div>
    </div>

    {/* Right Column: Floating Top-down Double Heart Latte Cup */}
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-cup-floating">
        <CupArt
          variant="double-heart"
          size={440}
          withSaucer={true}
          withHandle={true}
          class="hero-cup-component"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(24px, 4vw, 44px);
    padding-bottom: clamp(32px, 5vw, 64px);
    min-height: 520px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(24px, 4vw, 48px);
    position: relative;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  .hero-heading {
    font-size: var(--font-h1);
    font-weight: 700;
    line-height: 1.08;
    color: var(--espresso-900);
    letter-spacing: -0.02em;
    margin-top: clamp(20px, 3vw, 44px);
  }
  .heading-line {
    display: block;
  }

  .hero-cta-wrapper {
    margin-top: clamp(28px, 3.2vw, 42px);
  }
  .hero-cta-btn {
    width: clamp(170px, 16vw, 200px);
    height: 56px;
    font-size: 15px;
    font-weight: 500;
  }

  /* Chips row */
  .chips-row {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.6vw, 20px);
    margin-top: clamp(24px, 2.5vw, 32px);
  }
  .chip-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(54px, 4.8vw, 64px);
    height: clamp(54px, 4.8vw, 64px);
    border-radius: var(--radius-chip);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.65);
    color: var(--espresso-900);
    box-shadow: 0 8px 18px -4px rgba(40, 15, 8, 0.12);
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .chip-button:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 12px 24px -4px rgba(40, 15, 8, 0.2);
  }
  .chip-button:active {
    transform: scale(0.96);
  }

  /* Visual cup */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .hero-cup-floating {
    position: relative;
    top: -24px;
    right: -10px;
    animation: floatCup 7s ease-in-out infinite alternate;
  }

  @keyframes floatCup {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(-9px) rotate(-1deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cup-floating {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .hero-cup-component {
      width: 340px !important;
      height: 340px !important;
    }
  }

  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-visual {
      justify-content: center;
      margin-top: 16px;
    }
    .hero-cup-floating {
      top: 0;
      right: 0;
    }
    .hero-cup-component {
      width: 290px !important;
      height: 290px !important;
    }
  }
</style>
