---
import type { BeanPosition } from '../data/beans';

export interface Props {
  beans: BeanPosition[];
  stageWidth?: number | string;
  stageHeight?: number | string;
  class?: string;
}

const {
  beans,
  stageWidth = '100%',
  stageHeight = '100%',
  class: className = '',
} = Astro.props;
---

<div
  class={`bean-scatter ${className}`}
  style={`width: ${typeof stageWidth === 'number' ? `${stageWidth}px` : stageWidth}; height: ${typeof stageHeight === 'number' ? `${stageHeight}px` : stageHeight};`}
  aria-hidden="true"
>
  {beans.map((bean, idx) => (
    <div
      class="bean-item"
      style={`
        left: ${bean.x}px;
        top: ${bean.y}px;
        width: ${bean.size}px;
        height: ${Math.round(bean.size * 1.35)}px;
        transform: rotate(${bean.rotate}deg);
        opacity: ${bean.opacity ?? 1};
      `}
    >
      <svg
        viewBox="0 0 24 32"
        width="100%"
        height="100%"
        xmlns="http://www.w3.org/2000/svg"
        class="bean-svg"
      >
        <defs>
          <radialGradient id={`bean-grad-${idx}`} cx="40%" cy="40%" r="60%">
            <stop offset="0%" stop-color="#4B281E" />
            <stop offset="45%" stop-color="#341810" />
            <stop offset="90%" stop-color="#230E08" />
            <stop offset="100%" stop-color="#140603" />
          </radialGradient>
          <filter id={`bean-shadow-${idx}`} x="-20%" y="-20%" width="140%" height="140%">
            <feDropShadow dx="1" dy="3" stdDeviation="3" flood-color="rgba(25, 8, 4, 0.45)" />
          </filter>
        </defs>

        <g filter={`url(#bean-shadow-${idx})`}>
          {/* Bean Body */}
          <ellipse
            cx="12"
            cy="16"
            rx="10"
            ry="14"
            fill={`url(#bean-grad-${idx})`}
          />
          {/* Bean Highlight */}
          <ellipse
            cx="8.5"
            cy="11"
            rx="4"
            ry="7"
            fill="rgba(255, 255, 255, 0.08)"
            transform="rotate(-15 8.5 11)"
          />
          {/* Characteristic center curve crease */}
          <path
            d="M12 4 Q14 10, 11 16 Q8 22, 12 28"
            fill="none"
            stroke="#120502"
            stroke-width="1.8"
            stroke-linecap="round"
          />
          {/* Subtle crease highlight on one side */}
          <path
            d="M13 6 Q15 11, 12.5 16 Q10 21, 13 26"
            fill="none"
            stroke="rgba(160, 95, 60, 0.35)"
            stroke-width="0.8"
            stroke-linecap="round"
          />
        </g>
      </svg>
    </div>
  ))}
</div>

<style>
  .bean-scatter {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }
  .bean-item {
    position: absolute;
    user-select: none;
    pointer-events: none;
    transition: transform 0.4s ease;
  }
  .bean-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bean-item:nth-child(odd) {
        animation: beanWiggle 8s ease-in-out infinite alternate;
      }
      .bean-item:nth-child(even) {
        animation: beanWiggleReverse 9s ease-in-out infinite alternate;
      }
    }
  }

  @keyframes beanWiggle {
    0% { transform: rotate(var(--rot, 0deg)) translateY(0); }
    100% { transform: rotate(var(--rot, 0deg)) translateY(-4px); }
  }

  @keyframes beanWiggleReverse {
    0% { transform: rotate(var(--rot, 0deg)) translateY(0); }
    100% { transform: rotate(var(--rot, 0deg)) translateY(3px); }
  }
</style>
