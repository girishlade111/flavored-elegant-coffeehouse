---
import { siteData } from '../data/site';

const { reserve } = siteData;
---

<section class="reserve-section" id="contact" aria-labelledby="reserve-heading">
  <div class="reserve-container" data-reveal>
    {/* Top Row: Eyebrow + Heading on left, Contact Now button on right */}
    <div class="reserve-top-row">
      <div class="reserve-titles">
        <span class="reserve-eyebrow">{reserve.eyebrow}</span>
        <h2 class="reserve-heading" id="reserve-heading">
          {reserve.heading}
        </h2>
      </div>

      <div class="reserve-cta-wrapper">
        <a href={reserve.ctaHref} class="btn-pill btn-espresso reserve-cta-btn">
          {reserve.ctaText}
        </a>
      </div>
    </div>

    {/* Hairline Divider */}
    <div class="reserve-divider" role="separator"></div>

    {/* Explanatory Paragraph Below */}
    <p class="reserve-paragraph">
      {reserve.body}
    </p>
  </div>
</section>

<style>
  .reserve-section {
    position: relative;
    margin-top: clamp(80px, 9.5vw, 140px);
    padding-bottom: clamp(30px, 4vw, 60px);
  }
  .reserve-container {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .reserve-top-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .reserve-titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .reserve-eyebrow {
    font-size: var(--font-eyebrow);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--espresso-900);
    opacity: 0.85;
    margin-bottom: 6px;
  }

  .reserve-heading {
    font-size: clamp(26px, 2.7vw, 36px);
    font-weight: 700;
    line-height: 1.15;
    color: var(--espresso-900);
  }

  .reserve-cta-btn {
    width: clamp(180px, 16vw, 220px);
    height: 56px;
    font-size: 15px;
    font-weight: 500;
  }

  /* Full-width 1px hairline rgba(42,10,10,.25) */
  .reserve-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(42, 10, 10, 0.22);
    margin-top: clamp(20px, 2.2vw, 28px);
    margin-bottom: clamp(18px, 2vw, 24px);
  }

  .reserve-paragraph {
    font-size: clamp(13px, 1.05vw, 14.5px);
    line-height: 1.6;
    color: var(--text-body);
    max-width: 820px;
  }

  @media (max-width: 768px) {
    .reserve-top-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .reserve-cta-wrapper {
      width: 100%;
    }
    .reserve-cta-btn {
      width: 100%;
    }
  }
</style>
