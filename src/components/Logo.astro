---
export interface Props {
  tone?: 'espresso' | 'cream';
  class?: string;
}

const { tone = 'espresso', class: className = '' } = Astro.props;
---

<div class={`brand-logo ${tone} ${className}`}>
  <div class="brand-wordmark-row">
    <span class="brand-title">Flavored</span>
    <span class="brand-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 10h12v5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-5z" />
        <path d="M16 11h2a2 2 0 0 1 2 2v0a2 2 0 0 1-2 2h-2" />
        <path d="M7 4c0 1.5-1 2-1 3" />
        <path d="M11 3c0 1.5-1 2.5-1 4" />
        <path d="M15 4c0 1.5-1 2-1 3" />
      </svg>
    </span>
  </div>
  <p class="brand-tagline">Wake up to something special.</p>
</div>

<style>
  .brand-logo {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.15;
    user-select: none;
  }
  .brand-wordmark-row {
    display: inline-flex;
    align-items: flex-start;
    gap: 4px;
  }
  .brand-title {
    font-size: clamp(24px, 2vw, 28px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand-icon {
    display: inline-flex;
    margin-top: 1px;
  }
  .brand-tagline {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-top: 2px;
    opacity: 0.85;
  }

  /* Tones */
  .brand-logo.espresso {
    color: var(--espresso-900);
  }
  .brand-logo.cream {
    color: var(--cream-50);
  }
</style>
